# Secrets — never commit these. (The .env.example / .env.prod.example
# templates are fine and ARE tracked — only real .env / .env.prod files with
# actual values are excluded.)
.env
.env.*
!.env.example
!.env.prod.example

# Frontend (dispatch/) — Vite/React
node_modules/
dist/
dispatch/dist/
*.local

# Backend (dispatch/backend/) — Python / uv
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Generated/uploaded media — served from the DB now (app/media.py); this
# folder is just the legacy fallback and local dev scratch space.
dispatch/backend/media/*
!dispatch/backend/media/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp

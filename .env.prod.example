# Copy to .env (at this same root level — a different file from
# dispatch/backend/.env, which holds the app's own secrets) and fill in.
# docker-compose.prod.yml reads this automatically for ${VAR} substitution.

# Production Postgres credentials — pick a real password, not the dev default.
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=
POSTGRES_DB=dispatch

# Host port the frontend (nginx) listens on. Leave at 80 if this box sits
# behind a reverse proxy / tunnel (e.g. Cloudflare Tunnel) that terminates
# TLS and forwards plain HTTP here — that's the same pattern bcietech.com's
# other subdomains already use, and the simplest fit for this stack too,
# since this compose file does not do TLS termination itself.
#
# Set to 8089 here: on the demo VM, founderlens already occupies 8088
# (frontend), 8001 (backend), and 5433 (db) — 8089 keeps the same numbering
# pattern while staying clear of those. Change it if 8089 also turns out to
# be taken (confirm with `sudo ss -tlnp` on the VM).
WEB_PORT=8089

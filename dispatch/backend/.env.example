# Copy to .env and adjust as needed.
# Matches docker-compose.dev.yml defaults.
DATABASE_URL=postgresql+psycopg://dispatch:dispatch@localhost:5433/dispatch
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where the React app runs — TikTok's and Facebook's OAuth callbacks redirect
# back here.
FRONTEND_URL=http://localhost:5173
# This backend's own publicly reachable base url, no trailing slash (e.g.
# https://api.yourdomain.com). Only needed for Instagram publishing — its API
# always fetches media from a public url. Blank => Instagram posting is
# disabled with a clear error; everything else works without this.
PUBLIC_BASE_URL=

# Optional fallback Telegram bot token. A channel's own config.bot_token wins.
# Create a bot with @BotFather, then add it as an admin of your channel.
TELEGRAM_BOT_TOKEN=

# When true, "publishing" to a platform with no real integration just marks the
# post posted instead of raising. TikTok and Facebook/Instagram are real once
# configured below; YouTube still falls back to this.
SIMULATE_UNIMPLEMENTED_PLATFORMS=true

# TikTok Content Posting API — Channels → Add platform → TikTok. Register an
# app at https://developers.tiktok.com, add the Content Posting API product,
# and request the `video.upload` + `video.list` scopes. Add TIKTOK_REDIRECT_URI
# as a redirect URI on that app (must be a static https url — for local dev,
# tunnel this backend with e.g. ngrok and point it at
# "<tunnel url>/api/views/oauth/tiktok/callback"). By default posts land as a
# draft in the connected account's TikTok inbox — a person still taps Post to
# finish. See README.md's TikTok section for real auto-publish (Direct Post)
# via TikTok's Sandbox.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Off by default — flip on only after adding `video.publish` under the app's
# Sandbox tab (see README.md). Requesting it before that makes OAuth login
# fail outright. Existing connected channels are unaffected either way.
TIKTOK_REQUEST_DIRECT_POST=false
# Leave false until the app has actually passed TikTok's Direct Post audit —
# while false, Direct Post always uses SELF_ONLY regardless of what's picked
# in the composer (anything else is rejected outright pre-audit).
TIKTOK_APP_AUDITED=false

# Meta Graph API — Facebook Pages + Instagram, one shared app. Channels → Add
# platform → Facebook or Instagram. Create an app at
# https://developers.facebook.com, add "Facebook Login for Business", and add
# META_REDIRECT_URI as a valid OAuth redirect (must be a static https url —
# for local dev, tunnel this backend with e.g. ngrok and point it at
# "<tunnel url>/api/views/oauth/meta/callback"). While the app is in
# Development mode you can only post to Pages your own Meta account
# administers — a client's Page needs them added as a tester, or App Review
# for pages_manage_posts / instagram_content_publish to go further.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# In-process delivery worker: publishes scheduled posts once their time passes.
# Leave enabled unless you run the worker externally (POST /api/views/publish-due).
PUBLISH_WORKER_ENABLED=true
PUBLISH_WORKER_INTERVAL_SECONDS=60

# In-process daily content scheduler (Auto-generate page): writes each brand's
# batch of AI ideas once its "write at" time passes each day. Leave enabled
# unless you trigger it externally (POST /api/views/auto/{id}/run-now).
CONTENT_SCHEDULER_ENABLED=true

# Azure OpenAI — powers the AI agent's "Generate prompt" (falls back to a
# local template when unset). Endpoint should end with /openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-5-mini

# In-portal video generation (AI agent → "Generate video").
# VIDEO_PROVIDER = azure_sora | gemini_veo. Endpoints return 503 (and the UI
# offers "bring your own file") until the chosen provider is configured.
VIDEO_GENERATION_ENABLED=true
VIDEO_PROVIDER=azure_sora
VIDEO_MAX_SECONDS=20

# azure_sora — Sora is often in a different Azure resource/region than the chat
# model; set _ENDPOINT + _API_KEY to point video there, or leave blank to reuse
# the chat resource. _DEPLOYMENT is your Sora deployment name.
AZURE_OPENAI_VIDEO_ENDPOINT=
AZURE_OPENAI_VIDEO_API_KEY=
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora-2
AZURE_OPENAI_VIDEO_API_VERSION=preview

# Website check (Platforms → Website check): Google PageSpeed Insights key —
# console.cloud.google.com → APIs & Services → enable "PageSpeed Insights API"
# → Credentials → Create API key. Free; without it Google's scores are skipped
# whenever the shared daily quota is used up.
PAGESPEED_API_KEY=

# gemini_veo — Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Blank = call Google directly. Google blocks the Gemini API in some countries
# (e.g. Hong Kong, where the prod VM is) — then set this to the proxy URL from
# dispatch/gemini-proxy/README.md, e.g. https://gemini-proxy.<you>.workers.dev
GEMINI_BASE_URL=
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# Veo output size: 720p | 1080p | 4k (1080p/4k only for 8s clips; 4k not on Lite)
GEMINI_VIDEO_RESOLUTION=1080p

# Image generation (AI agent → "Generate image"). Synchronous.
# IMAGE_PROVIDER = azure_openai (gpt-image-1 / dall-e-3) | gemini_imagen (uses GEMINI_API_KEY)
# Blank _ENDPOINT/_API_KEY reuses the chat resource; fill to point image gen elsewhere.
IMAGE_GENERATION_ENABLED=true
IMAGE_PROVIDER=azure_openai
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# How many image renders may hit the provider at once app-wide (the rest queue).
IMAGE_MAX_CONCURRENCY=6

# Auth — set SECRET_KEY to a long random string for anything real.
SECRET_KEY=dev-insecure-change-me
TOKEN_TTL_HOURS=168
# Seeded login (created by app/seed.py). Change or blank out the password.
SEED_ADMIN_EMAIL=admin@tipsa.local
SEED_ADMIN_PASSWORD=changeme

# Platform admin portal (/admin-mkt): who signed up, usage, suspend / credit.
# Pick your own username and a long password. Either blank = portal off (404).
# Changing the password signs every admin session out.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web Push — lock-screen / desktop notifications (app/push.py). Make a pair
# once per server with:  python -m app.push keys
# (in Docker: docker compose -f docker-compose.prod.yml exec backend python -m app.push keys)
# Keep the same pair afterwards — changing it signs everyone's devices out of push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-domain.com
# Marketing advisor questions per workspace per day (app/advisor.py).
ADVISOR_DAILY_LIMIT=60

# --- Azure Speech: Khmer / English voice-over for motion videos (Speech resource → Keys and Endpoint)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# --- Azure OpenAI text-to-speech (gpt-4o-mini-tts): optional; Azure Speech is preferred for Khmer
AZURE_OPENAI_TTS_ENDPOINT=
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
# SPEECH_PROVIDER=azure | openai (blank = azure when set up)
# TTS_VOICE_FEMALE=coral
# TTS_VOICE_MALE=ash
# A local open-source Khmer voice for Khmer voice-overs (app/local_voice.py),
# run on the server's CPU instead of Azure — blank = Azure. One voice (Female
# and Male both use it); English words are written in Khmer letters first;
# subtitles use estimated timing. LICENSE: the MMS Khmer models are CC-BY-NC
# 4.0 (non-commercial) — the owner's decision. See testing/khmer-voice.
# KHMER_TTS_MODEL=khmerttsopensource/khmer-tts
# Khmer voice-overs: "gemini" (Google Gemini TTS — the most natural Khmer), "azure"
# (Sreymom / Piseth), or blank = Gemini when GEMINI_API_KEY is set. English stays on
# Azure; a Gemini line that fails is read by Azure instead.
# KHMER_SPEECH_PROVIDER=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Google caps each voice model at ~100 lines a day (10 a minute), even on Tier 1.
# When one is used up the next reads; Sreymom / Piseth only after all of them.
# GEMINI_TTS_BACKUP_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts
# GEMINI_TTS_VOICE_FEMALE=Kore
# GEMINI_TTS_VOICE_MALE=Charon
# The WRITER — a stronger model for content (storyboards, Khmer editing, voice lines,
# captions); may be on another Azure resource. Blank = AZURE_OPENAI_DEPLOYMENT writes.
# AZURE_OPENAI_WRITER_DEPLOYMENT=gpt-5
# AZURE_OPENAI_WRITER_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/
# AZURE_OPENAI_WRITER_API_KEY=

# Claude on Microsoft Foundry — one of the writing models customers can pick
# (app/ai_models.py; prices, markup and on/off in the admin portal → AI usage).
# The resource is the name before .services.ai.azure.com; blank = not offered.
AZURE_CLAUDE_RESOURCE=
AZURE_CLAUDE_API_KEY=
